# Fathom Automation Environment Variables
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# =============================================================================
# FATHOM API
# =============================================================================
# Get from: app.fathom.video/settings/integrations/api
FATHOM_API_KEY=your_fathom_api_key_here
FATHOM_WORKSPACE_ID=your_workspace_id_here

# =============================================================================
# OPENROUTER API
# =============================================================================
# Get from: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Model selection (optional - defaults are in Make.com scenario)
OPENROUTER_CONTENT_MODEL=openai/gpt-4o-mini
OPENROUTER_INTELLIGENCE_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SUMMARY_MODEL=openai/gpt-4o-mini

# =============================================================================
# NOTION API
# =============================================================================
# Get from: notion.so/my-integrations
NOTION_API_TOKEN=secret_your_notion_integration_token_here

# Database IDs (get from full-page database URLs)
# Format: https://notion.so/workspace/DATABASE_ID?v=...
NOTION_DB_CALL_INTELLIGENCE_HUB=your_32_char_database_id_here
NOTION_DB_CONTENT_IDEAS_BANK=your_32_char_database_id_here
NOTION_DB_CLIENT_INTELLIGENCE=your_32_char_database_id_here

# =============================================================================
# MAKE.COM
# =============================================================================
# For reference only (not used in code)
MAKECOM_ORG_ID=your_org_id
MAKECOM_SCENARIO_ID=your_scenario_id

# =============================================================================
# OPTIONAL: MONITORING & ALERTS
# =============================================================================
# Email for error notifications
ALERT_EMAIL=your-email@example.com

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# COST TRACKING
# =============================================================================
# Monthly budget alert threshold (in USD)
MONTHLY_BUDGET_ALERT=50

# Operations limit warning (Make.com free tier = 1000)
OPERATIONS_LIMIT_WARNING=900

# =============================================================================
# TESTING / DEVELOPMENT
# =============================================================================
# Set to 'true' to use cheaper models for testing
USE_TEST_MODELS=false

# Set to 'true' to skip AI calls and use mock data
DRY_RUN_MODE=false
